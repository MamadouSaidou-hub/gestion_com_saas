# ---------------------------------------------------------------------------
# Env placeholders — never commit real values. Fill these in your secret store
# (Vercel/Render env vars, not .env in git) per environment (dev/staging/prod).
# ---------------------------------------------------------------------------

# Migrator role: owns the schema, runs drizzle-kit migrations. Full DDL rights.
# Never used by the running app, only by CI/CD migration jobs.
DATABASE_URL_MIGRATOR=postgres://migrator:<password>@<host>:5432/<db>?sslmode=require

# App role: used by the Next.js app at runtime (Route Handlers / Server
# Actions). Owns no tables, cannot ALTER/DROP, cannot touch audit_log directly
# (routes through audit_log_append()). RLS is enforced (FORCE ROW LEVEL
# SECURITY) for every tenant-scoped table under this role.
DATABASE_URL=postgres://app_user:<password>@<host>:5432/<db>?sslmode=require

# Better Auth (src/modules/identity/auth.ts). Generate a real secret with
# `openssl rand -base64 32` per environment -- never reuse the dev value.
BETTER_AUTH_SECRET=<random-32-byte-secret>
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
