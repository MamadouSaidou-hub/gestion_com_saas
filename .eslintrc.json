          {
            "patterns": [
              { "group": ["@/modules/stock-transfers/domain/*", "@/modules/stock-transfers/infrastructure/*", "@/modules/inventory/domain/*", "@/modules/inventory/infrastructure/*", "@/modules/sales/domain/*", "@/modules/sales/infrastructure/*", "@/modules/billing/domain/*", "@/modules/billing/infrastructure/*", "@/modules/analytics/domain/*", "@/modules/analytics/infrastructure/*"], "message": "Cross-module boundary: catalog may only reach another business module through its public index.ts surface -- even from infrastructure/." }
